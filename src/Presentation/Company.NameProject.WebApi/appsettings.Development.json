{
  "Swagger": {
    "PublicServerUrl": ""
  },
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/dev-log-.txt",
          "rollingInterval": "Minute",
          "retainedFileCountLimit": 240,
          "rollOnFileSizeLimit": true,
          "fileSizeLimitBytes": 5242880,
          "shared": true,
          "outputTemplate": "{{\"fecha\":\"{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz}\",\"token\":\"{Token}\",\"tipoTransaccion\":\"{TipoTransaccion}\",\"metodo\":\"{Metodo}\",\"capa\":\"{Capa}\",\"mensaje\":\"{Message:lj}\"}}{NewLine}{Exception}"
        }
      }
    ],
    "Properties": {
      "Environment": "Development"
    },
    "PostgreSql": {
      "ConnectionString": "Host=192.168.82.133;Port=5432;Database=db_demo;Username=postgres;Password=postgres;Include Error Detail=true",
      "TableName": "application_logs"
    }
  }
}
