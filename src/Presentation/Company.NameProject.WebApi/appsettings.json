{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=MiBaseDatos;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "Jwt": {
    "Secret": "CAMBIAR-ESTE-SECRET-POR-UNO-SEGURO-DE-AL-MENOS-32-CARACTERES",
    "Issuer": "Company.NameProject",
    "Audience": "Company.NameProject.Client",
    "ExpirationMinutes": 60
  },
  "ApiInfo": {
    "Title": "Company.NameProject API",
    "Version": "v1",
    "Description": "API REST construida con Clean Architecture + DDD.",
    "ContactName": "Equipo de Desarrollo",
    "ContactEmail": "dev@company.com"
  },
  "Swagger": {
    "PublicServerUrl": ""
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:4200" ]
  },
//#if (IncludeRabbit)
  "RabbitMq": {
    "Host": "localhost",
    "Port": 5672,
    "Username": "guest",
    "Password": "guest",
    "VirtualHost": "/",
    "ExchangeName": "Company.NameProject.exchange"
  },
//#endif
//#if (IncludeEureka)
  "eureka": {
    "client": {
      "serviceUrl": "http://eureka-server:8761/eureka",
      "shouldRegisterWithEureka": true,
      "shouldFetchRegistry": true,
      "validateCertificates": false
    },
    "instance": {
      "appName": "NameProject-service",
      "instanceId": "NameProject-service:",
      "preferIpAddress": true,
      "leaseRenewalIntervalInSeconds": 10,
      "leaseExpirationDurationInSeconds": 30,
      "healthCheckUrlPath": "/health",
      "statusPageUrlPath": "/info",
      "securePortEnabled": false
    }
  },
//#endif
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    },
    "Enrich": [ "FromLogContext" ],
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/log-.txt",
          "rollingInterval": "Hour",
          "retainedFileCountLimit": 168,
          "rollOnFileSizeLimit": true,
          "fileSizeLimitBytes": 10485760,
          "shared": true,
          "outputTemplate": "{{\"fecha\":\"{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz}\",\"token\":\"{Token}\",\"tipoTransaccion\":\"{TipoTransaccion}\",\"metodo\":\"{Metodo}\",\"capa\":\"{Capa}\",\"mensaje\":\"{Message:lj}\"}}{NewLine}{Exception}"
        }
      }
    ],
    "Properties": {
      "Application": "Company.NameProject.WebApi",
      "Environment": "Production"
    }
  },
  "SerilogSqlSinkTemplate": {
    "PackageReference": "Serilog.Sinks.MSSqlServer",
    "WriteToItem": {
      "Name": "MSSqlServer",
      "Args": {
        "connectionString": "Server=localhost;Database=MiBaseDatos;Trusted_Connection=True;TrustServerCertificate=True;",
        "sinkOptionsSection": {
          "tableName": "ApplicationLogs",
          "schemaName": "dbo",
          "autoCreateSqlTable": false,
          "batchPostingLimit": 50,
          "batchPeriod": "0.00:00:05"
        },
        "restrictedToMinimumLevel": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
