  "ConnectionStrings": {
    "DefaultConnection": "Data Source=192.168.82.168;Initial Catalog=SIAC;Persist Security Info=True;User ID=Appcrecob;Password=cresa_UAT3;App=ServicioCliente.Backend.Api;MultipleActiveResultSets=True;TrustServerCertificate=True;",
    "SerilogPostgreSql": "Host=localhost;Database=db_demo;Username=postgres;Password=Admin123;Pooling=true;Minimum Pool Size=10;Maximum Pool Size=100;Connection Idle Lifetime=300;Keepalive=30"
  },
  "Jwt": {
    "Secret": "CAMBIAR-ESTE-SECRET-POR-UNO-SEGURO-DE-AL-MENOS-32-CARACTERES",
    "Issuer": "Company.NameProject",
    "Audience": "Company.NameProject.Client",
    "ExpirationMinutes": 60
  },
  "ApiInfo": {
    "Title": "Company.NameProject API",
    "Version": "v1",
    "Description": "API REST construida con Clean Architecture + DDD.",
    "ContactName": "Equipo de Desarrollo",
    "ContactEmail": "dev@company.com"
  },
  "Swagger": {
    "PublicServerUrl": ""
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:4200" ]
  },
//#if (IncludeRabbit)
  "RabbitMq": {
    "Host": "localhost",
    "Port": 5672,
    "Username": "guest",
    "Password": "guest",
    "VirtualHost": "/",
    "ExchangeName": "Company.NameProject.exchange"
  },
//#endif
//#if (IncludeEureka)
  "eureka": {
    "client": {
      "serviceUrl": "http://eureka-manager:8761/eureka,http://eureka-worker-1:8761/eureka,http://eureka-worker-2:8761/eureka",
      "shouldRegisterWithEureka": true,
      "shouldFetchRegistry": true,
      "validateCertificates": false
    },
    "instance": {
      "appName": "NameProject-service",
      "instanceId": "NameProject-service:",
      "preferIpAddress": true,
      "leaseRenewalIntervalInSeconds": 10,
      "leaseExpirationDurationInSeconds": 30,
      "healthCheckUrlPath": "/health",
      "statusPageUrlPath": "/info",
      "securePortEnabled": false
    }
  },
//#endif
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File", "Serilog.Sinks.PostgreSQL" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    },
    "Enrich": [ "FromLogContext" ],
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/log-.txt",
          "rollingInterval": "Hour",
          "retainedFileCountLimit": 168,
          "rollOnFileSizeLimit": true,
          "fileSizeLimitBytes": 10485760,
          "shared": true,
          "outputTemplate": "{{\"fecha\":\"{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz}\",\"token\":\"{Token}\",\"tipoTransaccion\":\"{TipoTransaccion}\",\"metodo\":\"{Metodo}\",\"capa\":\"{Capa}\",\"mensaje\":\"{Message:lj}\"}}{NewLine}{Exception}"
        }
      }
    ],
    "Properties": {
      "Application": "Company.NameProject.WebApi",
      "Environment": "Production"
    },
    "PostgreSql": {
      "ConnectionString": "Host=localhost;Port=5432;Database=nameprojectdb;Username=postgres;Password=postgres;Include Error Detail=true",
      "TableName": "application_logs"
    }
  },
  "SerilogSqlSinkTemplate": {
    "PackageReference": "Serilog.Sinks.PostgreSQL",
    "WriteToItem": {
      "Name": "PostgreSQL",
      "Args": {
        "connectionString": "Host=localhost;Port=5432;Database=nameprojectdb;Username=postgres;Password=postgres;Include Error Detail=true",
        "tableName": "application_logs",
        "needAutoCreateTable": false,
        "restrictedToMinimumLevel": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
